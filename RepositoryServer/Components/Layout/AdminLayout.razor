@inherits LayoutComponentBase
@inject AdminAuthMode AuthMode
@inject NavigationManager Navigation

@*
    Hosts have to live in the layout rather than a page: toasts and dialogs raised by a page are
    rendered by these, so they need to outlive the page that opened them. BbPortalHost is what
    every floating element (dropdowns, popovers, dialog overlays) renders into.
*@
<BbPortalHost/>
<BbDialogProvider/>
@* Style guide §5: request-level errors go to a toast, top-center. *@
<BbToastProvider Position="ToastPosition.TopCenter" PauseOnHover="true"/>

<BbTooltipProvider>
    <BbSidebarProvider ShouldPersist="true">
        <BbSidebar>
            <BbSidebarHeader>
                <a href="@AdminNav.OverviewHref" aria-label="Repository Server overview" class="bb:block bb:px-1 bb:py-1">
                    <Logo/>
                </a>
            </BbSidebarHeader>

            <BbSidebarContent>
                <BbSidebarGroup>
                    <BbSidebarGroupContent>
                        <BbSidebarMenu>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="@AdminNav.Overview.Href" Match="NavLinkMatch.All"
                                                     Tooltip="@AdminNav.Overview.Title">
                                    <Glyph Name="AdminNav.Overview.Icon"/>
                                    <span>@AdminNav.Overview.Title</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </BbSidebarMenu>
                    </BbSidebarGroupContent>
                </BbSidebarGroup>

                @NavGroups(AdminNav.Primary)

                @* Pushes setup to the bottom, so day-to-day pages stay at the top. *@
                <div class="bb:grow" aria-hidden="true"></div>

                @NavGroups(AdminNav.Footer)
            </BbSidebarContent>
        </BbSidebar>

        @*
            Shell per style guide §2.1: a full-viewport, non-scrolling frame with exactly one scroll
            container inside it. main is flex-1 min-h-0: without min-h-0 a flex child refuses to
            shrink below its content and the page grows instead of scrolling.
        *@
        <BbSidebarInset Class="bb:flex h-screen bb:min-w-0 bb:flex-col bb:overflow-hidden">
            @*
                Red rather than the guide's orangered: this is not "you are on dev", it is "this
                server currently has no authentication at all", which is the same severity as a
                destructive action. Uses the destructive token so it tracks the theme.
            *@
            @if (AuthMode.DevBypass)
            {
                <div class="bb:bg-destructive bb:text-destructive-foreground bb:flex flex-none bb:items-center bb:justify-center bb:gap-2 bb:px-3 bb:py-1.5 bb:text-sm bb:font-medium"
                     role="alert">
                    <Glyph Name="IconName.Warning" Class="bb:size-4 bb:shrink-0"/>
                    <span>
                        Authentication is disabled. Every request is granted full administrator access
                        without a login. Do not expose this server to a network.
                    </span>
                </div>
            }

            @* Style guide §2.2: sidebar toggle, separator, breadcrumbs, elastic spacer, theme, user. *@
            <header class="bb:flex bb:h-12 bb:shrink-0 bb:items-center bb:gap-2 bb:border-b bb:px-3">
                <BbSidebarTrigger/>
                <div class="bb:bg-border mr-2 bb:h-4 bb:w-px bb:shrink-0" aria-hidden="true"></div>

                <nav aria-label="Breadcrumb" class="bb:flex bb:min-w-0 bb:items-center bb:gap-1.5 bb:text-sm">
                    @{ var trail = AdminNav.Trail(Navigation.ToBaseRelativePath(Navigation.Uri)); }
                    @for (var i = 0; i < trail.Count; i++)
                    {
                        var crumb = trail[i];
                        var isLast = i == trail.Count - 1;

                        @if (isLast)
                        {
                            <span class="bb:truncate bb:font-medium" aria-current="page">@crumb.Label</span>
                        }
                        else
                        {
                            @if (crumb.Href is not null)
                            {
                                <a href="@crumb.Href" class="bb:text-muted-foreground bb:hover:text-foreground bb:whitespace-nowrap bb:transition-colors">@crumb.Label</a>
                            }
                            else
                            {
                                <span class="bb:text-muted-foreground bb:hidden bb:whitespace-nowrap sm:inline">@crumb.Label</span>
                            }
                            <span class="@(crumb.Href is null ? "bb:text-muted-foreground bb:hidden sm:inline" : "bb:text-muted-foreground")" aria-hidden="true">/</span>
                        }
                    }
                </nav>

                <div class="bb:flex-1"></div>

                <ThemeSwitch/>

                <AuthorizeView>
                    <Authorized>
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger AsChild="false" Class="bb:text-muted-foreground bb:hover:text-foreground bb:flex bb:cursor-pointer bb:items-center bb:gap-2 bb:text-sm bb:select-none">
                                <span class="bb:bg-muted bb:text-foreground bb:flex bb:size-8 bb:items-center bb:justify-center bb:rounded-full bb:text-xs bb:font-medium bb:uppercase" aria-hidden="true">
                                    @Initial(context.User.Identity?.Name)
                                </span>
                                <span class="bb:hidden lg:inline-block">@context.User.Identity?.Name</span>
                                <span class="bb:sr-only">Account menu</span>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent>
                                <BbDropdownMenuItem OnClick="SignOut" Class="bb:flex bb:cursor-pointer bb:items-center bb:gap-2">
                                    <Glyph Name="IconName.LogOut"/>
                                    Sign out
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </Authorized>
                </AuthorizeView>
            </header>

            <main class="bb:min-h-0 bb:flex-1 bb:overflow-x-hidden">
                @*
                    The page container, §2.4. Pages are its direct children and inherit the gap-4,
                    which is why they carry no vertical margins of their own. The bottom padding is
                    larger than the guide's because admin pages regularly outgrow the viewport, and a
                    table should not end flush against the footer.
                *@
                <div class="container bb:mx-auto bb:flex bb:min-h-full bb:flex-col bb:items-start bb:justify-start bb:gap-4 bb:px-4 bb:pt-4 pb-6 sm:px-12 sm:pt-12 sm:pb-8">
                    @Body
                </div>
            </main>

            <footer class="bb:text-muted-foreground bb:flex flex-none bb:items-center bb:justify-between bb:gap-4 bb:border-t bb:px-3 bb:py-1 bb:text-sm">
                <div class="bb:truncate">
                    Made with <span class="bb:text-destructive" aria-hidden="true">&hearts;</span><span class="bb:sr-only">love</span> by the
                    <a href="https://github.com/OpenShock" target="_blank" rel="noopener" class="bb:hover:text-foreground">OpenShock Team</a>
                </div>
                <div class="bb:flex bb:shrink-0 bb:items-center bb:gap-4">
                    @* The API reference is served by this process but is not a Blazor route. *@
                    <a href="/scalar" target="_blank" rel="noopener" class="bb:hover:text-foreground bb:hidden sm:inline">API reference</a>
                    <span class="bb:font-mono bb:text-xs" title="Running server version">@Version</span>
                </div>
            </footer>
        </BbSidebarInset>
    </BbSidebarProvider>
</BbTooltipProvider>

@code {
    private static readonly string Version = ResolveVersion();

    private static string ResolveVersion()
    {
        var version = typeof(AdminLayout).Assembly
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()?.InformationalVersion ?? "dev";

        // The SDK appends "+<commit>"; the short form is enough to tell two deployments apart.
        var plus = version.IndexOf('+');
        return plus < 0 ? version : $"{version[..plus]}+{AdminFormat.ShortCommit(version[(plus + 1)..])}";
    }

    private static string Initial(string? name) => string.IsNullOrEmpty(name) ? "?" : name[..1];

    // A full page load: /auth/logout is an HTTP endpoint that clears the cookie, not a Blazor route.
    private void SignOut() => Navigation.NavigateTo("/auth/logout", forceLoad: true);

    private static RenderFragment NavGroups(AdminNavGroup[] groups) => @<text>
        @foreach (var group in groups)
        {
            <BbSidebarGroup>
                <BbSidebarGroupLabel>@group.Title</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        @foreach (var item in group.Items)
                        {
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="@item.Href" Tooltip="@item.Title">
                                    <Glyph Name="item.Icon"/>
                                    <span>@item.Title</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        }
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        }
    </text>;
}
