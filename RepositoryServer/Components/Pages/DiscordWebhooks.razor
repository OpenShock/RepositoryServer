@page "/admin/discord-webhooks"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Discord webhooks">
    <Subtitle>Notification targets for firmware and desktop module publishing, subscribed per event.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add webhook</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="DiscordWebhook" TableContainerClass="@TableFrame.TableClass" Items="_webhooks" IsLoading="Loading" StickyHeader="true">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Bell" Title="No webhooks" Description="Nobody is notified about publishes.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add the first webhook</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="DiscordWebhook" TProp="string" Property="w => w.Name" Title="Name"/>
            @* Masked: the URL is a credential, and anyone who can read it can post to the channel. *@
            <BbDataGridTemplateColumn TData="DiscordWebhook" Title="URL" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <code class="bb:text-muted-foreground">@DiscordWebhookMasking.Mask(context.Url)</code>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="DiscordWebhook" Title="Events" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                @if (context.Events.Length == 0)
                {
                    @* An enabled webhook with no events never fires, which is not what anyone meant. *@
                    <BbBadge Variant="@(context.Enabled ? BadgeVariant.SoftWarning : BadgeVariant.Outline)">No events</BbBadge>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:gap-1">
                        @foreach (var notificationEvent in context.Events)
                        {
                            <BbBadge Variant="BadgeVariant.Outline">@notificationEvent.ToEventName()</BbBadge>
                        }
                    </div>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridPropertyColumn TData="DiscordWebhook" TProp="bool" Property="w => w.Enabled" Title="Status">
                <CellTemplate>
                    <StatusDot Active="context.Enabled" Label="@(context.Enabled ? "Enabled" : "Disabled")"/>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="DiscordWebhook" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingId is null ? "Add a webhook" : $"Edit {_name}")</BbDialogTitle>
            <BbDialogDescription>
                Subscribing per event lets maintainer alerts go somewhere other than a public
                releases channel.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="name">Name</BbLabel>
                <BbInput Id="name" @bind-Value="_name" Placeholder="releases channel"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="url">URL</BbLabel>
                <BbInput Id="url" @bind-Value="_url" Type="InputType.Password"
                         Placeholder="https://discord.com/api/webhooks/..."/>
                @if (_editingId is not null)
                {
                    <p class="bb:text-muted-foreground bb:text-xs">Leave empty to keep the stored one.</p>
                }
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Events</BbLabel>
                @foreach (var notificationEvent in Events)
                {
                    var current = notificationEvent;
                    <div class="bb:flex bb:items-center bb:gap-2">
                        <BbCheckbox Id="@($"event-{current}")" Checked="_events.Contains(current)"
                                    CheckedChanged="@(checkedNow => ToggleEvent(current, checkedNow))"/>
                        <BbLabel For="@($"event-{current}")">@current.ToEventName()</BbLabel>
                    </div>
                }
            </div>
            <div class="bb:flex bb:items-center bb:gap-2">
                <BbSwitch Id="enabled" @bind-Checked="_enabled"/>
                <BbLabel For="enabled">Enabled</BbLabel>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly DiscordNotificationEvent[] Events = Enum.GetValues<DiscordNotificationEvent>();

    private DiscordWebhook[] _webhooks = [];

    private bool _formOpen;
    private Guid? _editingId;
    private string _name = string.Empty;
    private string? _url;
    private readonly HashSet<DiscordNotificationEvent> _events = [];
    private bool _enabled = true;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _webhooks = await scope.Get<DiscordWebhookAdminService>().ListAsync();
    }

    private void ToggleEvent(DiscordNotificationEvent notificationEvent, bool selected)
    {
        if (selected) _events.Add(notificationEvent);
        else _events.Remove(notificationEvent);
    }

    private void OpenCreate()
    {
        ResetForm();
        _formOpen = true;
    }

    private void OpenEdit(DiscordWebhook webhook)
    {
        _formOpen = true;
        _editingId = webhook.Id;
        _name = webhook.Name;
        // Never populated from the stored value: it is a credential and the UI only ever shows it masked.
        _url = null;
        _events.Clear();
        foreach (var notificationEvent in webhook.Events) _events.Add(notificationEvent);
        _enabled = webhook.Enabled;
    }

    private void ResetForm()
    {
        _editingId = null;
        _name = string.Empty;
        _url = null;
        _events.Clear();
        _enabled = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            ReportError("Name is required.");
            return;
        }

        var url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim();
        var events = _events.ToArray();

        if (_editingId is null && url is null)
        {
            ReportError("A URL is required for a new webhook.");
            return;
        }

        // Read the form into locals before it is cleared: the change below runs after the dialog
        // has closed, and a field cleared underneath it would save an unnamed webhook.
        var editingId = _editingId;
        var name = _name;
        var enabled = _enabled;

        _formOpen = false;
        ResetForm();

        await MutateAsync(async scope =>
        {
            var webhooks = scope.Get<DiscordWebhookAdminService>();

            if (editingId is { } webhookId)
            {
                var result = await webhooks.UpdateAsync(webhookId, name, url, events, enabled);

                Report(
                    result.Match<string?>(
                        _ => null,
                        _ => "That webhook no longer exists."),
                    "Saved.");
            }
            else
            {
                await webhooks.CreateAsync(name, url!, events, enabled);
                Report(null, "Created.");
            }
        });
    }

    private async Task DeleteAsync(DiscordWebhook webhook)
    {
        if (!await ConfirmAsync("Delete webhook", $"Delete \"{webhook.Name}\"?")) return;

        if (_editingId == webhook.Id) ResetForm();

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<DiscordWebhookAdminService>().DeleteAsync(webhook.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That webhook no longer exists."),
                "Deleted.");
        });
    }
}
