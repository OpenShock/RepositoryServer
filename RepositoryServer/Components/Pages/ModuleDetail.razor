@page "/admin/desktop/modules/{ModuleId}"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using System.Diagnostics.CodeAnalysis
@using OpenShock.RepositoryServer.RepoServerDb.Models
@using OpenShock.RepositoryServer.Services
@using OpenShock.RepositoryServer.Utils
@using OpenShock.RepositoryServer.Config
@inherits AdminDataPageBase

<PageHeader Title="@(_module?.Name ?? ModuleId)">
    <Subtitle>Everything the desktop index advertises for <code>@ModuleId</code>.</Subtitle>
    <Actions>
        @if (_module is not null)
        {
            <BbButton OnClick="OpenUpload"><Glyph Name="IconName.Upload"/>Upload version</BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCreateVersion"><Glyph Name="IconName.ExternalLink"/>Register by URL</BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="OpenEditModule"><Glyph Name="IconName.Pencil"/>Edit module</BbButton>
        }
    </Actions>
</PageHeader>

@* Style guide §5: the read is page-wide here, so the loading state is one centred spinner. *@
@if (Loading)
{
    <div class="bb:flex h-64 bb:w-full bb:items-center bb:justify-center">
        <BbSpinner Class="bb:text-muted-foreground bb:size-8"/>
    </div>
}
else if (LoadFailed)
{
    <TableFrame Failed="true" OnRetry="ReloadAsync"/>
}
else if (_module is null)
{
    <EmptyState Icon="IconName.SearchX" Title="No such module"
                Description="@($"Nothing has the id {ModuleId}. It was either deleted or never created.")">
        <BbButton Variant="ButtonVariant.Outline" Href="/admin/desktop/modules">All modules</BbButton>
    </EmptyState>
}
else
{
    <dl class="bb:bg-card bb:grid bb:w-full bb:grid-cols-1 gap-x-8 gap-y-1 bb:rounded-md bb:border bb:p-4 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-y-3">
        <dt class="bb:text-muted-foreground bb:text-sm">Id</dt>
        <dd class="bb:mb-2 sm:mb-0"><code>@_module.Id</code></dd>

        <dt class="bb:text-muted-foreground bb:text-sm">Owning repository</dt>
        <dd class="bb:mb-2 sm:mb-0">
            @if (OwnerName(_module.RepositoryId) is { } owner)
            {
                <code>@owner</code>
            }
            else
            {
                @* The publisher story is the point of this row, so the reason is spelled out. *@
                <span class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                    <BbBadge Variant="BadgeVariant.SoftWarning">No owner</BbBadge>
                    <span class="bb:text-muted-foreground bb:text-sm">No CI may publish to this module.</span>
                </span>
            }
        </dd>

        <dt class="bb:text-muted-foreground bb:text-sm">Description</dt>
        <dd class="bb:mb-2 sm:mb-0">@(string.IsNullOrWhiteSpace(_module.Description) ? "Not set" : _module.Description)</dd>

        <dt class="bb:text-muted-foreground bb:text-sm">Source</dt>
        <dd class="bb:mb-2 bb:min-w-0 bb:truncate sm:mb-0">
            @if (_module.SourceUrl is { } sourceUrl)
            {
                <a href="@sourceUrl" class="bb:underline" target="_blank" rel="noreferrer">@sourceUrl</a>
            }
            else
            {
                <span class="bb:text-muted-foreground">Not set</span>
            }
        </dd>

        <dt class="bb:text-muted-foreground bb:text-sm">Icon</dt>
        <dd class="bb:min-w-0 bb:truncate">
            @if (_module.IconUrl is { } iconUrl)
            {
                <a href="@iconUrl" class="bb:underline" target="_blank" rel="noreferrer">@iconUrl</a>
            }
            else
            {
                <span class="bb:text-muted-foreground">Not set</span>
            }
        </dd>
    </dl>

    <section class="bb:mt-2 bb:flex bb:w-full bb:flex-col bb:gap-3" aria-labelledby="versions-heading">
        <div>
            <h2 id="versions-heading" class="bb:text-lg bb:font-semibold">Published versions</h2>
            <p class="bb:text-muted-foreground bb:text-sm">
                Newest first by semantic version. Normally published by the module's CI; upload a zip here
                to publish one by hand. Withdrawing one removes it from the index but keeps the zip in storage.
            </p>
        </div>

        @* No IsLoading: this whole block only renders once the read has finished. *@
        <TableFrame>
            <BbDataGrid TData="VersionRow" TableContainerClass="@TableFrame.TableClass" Items="_versions" StickyHeader="true">
                <EmptyTemplate>
                    <EmptyState Compact="true" Icon="IconName.Package" Title="Nothing published"
                                Description="The module's CI publishes here once it is wired up.">
                        <BbButton Variant="ButtonVariant.Outline" OnClick="OpenUpload">Upload a version</BbButton>
                    </EmptyState>
                </EmptyTemplate>
                <Columns>
                    <BbDataGridPropertyColumn TData="VersionRow" TProp="string" Property="v => v.Name"
                                              Title="Version" Sortable="false">
                        <CellTemplate>
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <code>@context.Name</code>
                                @if (!context.Parseable)
                                {
                                    @* The index parses every stored version, so this row breaks it. *@
                                    <BbBadge Variant="BadgeVariant.SoftDestructive">Not semver</BbBadge>
                                }
                                else if (context.IsPrerelease)
                                {
                                    <BbBadge Variant="BadgeVariant.Secondary">Pre-release</BbBadge>
                                }
                            </div>
                        </CellTemplate>
                    </BbDataGridPropertyColumn>
                    <BbDataGridTemplateColumn TData="VersionRow" Title="Zip" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                            <a href="@context.ZipUrl" class="bb:underline" target="_blank" rel="noreferrer"
                               title="@context.ZipUrl">@Shorten(context.ZipUrl)</a>
                            @if (!context.Hosted)
                            {
                                @* A fixed URL does not follow Modules:CdnBaseUrl. *@
                                <BbBadge Variant="BadgeVariant.Secondary">External</BbBadge>
                            }
                        </div>
                    </BbDataGridTemplateColumn>
                    <BbDataGridTemplateColumn TData="VersionRow" Title="SHA-256" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                        <span class="bb:text-muted-foreground bb:font-mono bb:text-xs" title="@context.Hash">@(context.Hash[..12])&hellip;</span>
                    </BbDataGridTemplateColumn>
                    <BbDataGridTemplateColumn TData="VersionRow" Title="Links" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-3">
                            @if (context.ChangelogUrl is { } changelogUrl)
                            {
                                <a href="@changelogUrl" class="bb:text-sm bb:underline" target="_blank" rel="noreferrer">Changelog</a>
                            }
                            @if (context.ReleaseUrl is { } releaseUrl)
                            {
                                <a href="@releaseUrl" class="bb:text-sm bb:underline" target="_blank" rel="noreferrer">Release</a>
                            }
                        </div>
                    </BbDataGridTemplateColumn>
                    <BbDataGridTemplateColumn TData="VersionRow" Title="" Sortable="false" Width="0">
                        <RowActions>
                            <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEditVersion(context)"/>
                            <RowAction Label="Withdraw" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteVersionAsync(context)"/>
                        </RowActions>
                    </BbDataGridTemplateColumn>
                </Columns>
            </BbDataGrid>
        </TableFrame>
    </section>

    <section class="bb:mt-2 bb:flex bb:w-full bb:flex-wrap bb:items-center bb:justify-between gap-x-4 gap-y-2 bb:rounded-md bb:border bb:px-4 bb:py-3" aria-label="Delete module">
        <div class="bb:min-w-0">
            <p class="bb:font-medium">Delete this module</p>
            <p class="bb:text-muted-foreground bb:text-sm">Removes it and every version it advertises from the index.</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" Class="bb:text-destructive" OnClick="DeleteModuleAsync">
            <Glyph Name="IconName.Trash"/>
            Delete module
        </BbButton>
    </section>
}

<ModuleFormDialog @bind-Open="_moduleFormOpen" Model="_moduleForm" Repositories="_repositories"
                  IdLocked="true" OnSave="SaveModuleAsync"/>

<BbDialog @bind-Open="_uploadOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>Upload a version</BbDialogTitle>
            <BbDialogDescription>
                Publishes the zip exactly as the module's CI would: the archive is checked, hashed and
                written to module storage, and the version is added to the index. Published versions
                are immutable, so an existing version cannot be uploaded again.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="upload-version">Version</BbLabel>
                <BbInput Id="upload-version" @bind-Value="_upload.Name" Disabled="_uploading" Placeholder="1.4.0"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="upload-zip">Module zip</BbLabel>
                <InputFile id="upload-zip" OnChange="SelectZip" accept=".zip" disabled="@_uploading"
                           class="bb:border-input bb:w-full bb:cursor-pointer bb:rounded-md bb:border bb:text-sm bb:file:border-0"/>
                <p class="bb:text-muted-foreground bb:text-xs">
                    Only .dll, .pdb and .json files at the root, plus optional wwwroot and libs folders. Up to
                    @(ModulePublishService.MaxZipSize / 1024 / 1024) MB.
                </p>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="upload-changelog">Changelog URL</BbLabel>
                <BbInput Id="upload-changelog" @bind-Value="_upload.ChangelogUrl" Disabled="_uploading"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="upload-release">Release URL</BbLabel>
                <BbInput Id="upload-release" @bind-Value="_upload.ReleaseUrl" Disabled="_uploading"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" Disabled="_uploading" OnClick="() => _uploadOpen = false">Cancel</BbButton>
            <BbButton OnClick="UploadVersionAsync" Disabled="_uploading">
                @if (_uploading)
                {
                    <BbSpinner Size="SpinnerSize.Small"/>
                    <span>Uploading&hellip;</span>
                }
                else
                {
                    <span>Upload</span>
                }
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_versionFormOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>
                @(_editingVersion ? $"Edit {_versionForm.Name}" : "Register a version by URL")
            </BbDialogTitle>
            <BbDialogDescription>
                This writes only the row that advertises the zip — no bytes are uploaded or moved, and
                nothing verifies the digest against the file, so it has to be the digest of the zip it
                points at or every install of this version fails.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="version-name">Version</BbLabel>
                <BbInput Id="version-name" @bind-Value="_versionForm.Name" Disabled="_editingVersion"
                         Placeholder="1.4.0"/>
                <p class="bb:text-muted-foreground bb:text-xs">
                    Strict semantic versioning. The index parses every stored version, so one that does
                    not parse breaks the whole index rather than only itself.
                </p>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="version-zip">Zip URL</BbLabel>
                <BbInput Id="version-zip" @bind-Value="_versionForm.ZipUrl"
                         Placeholder="@HostedUrl(_versionForm.Name)"/>
                <p class="bb:text-muted-foreground bb:text-xs">
                    Leave empty when the zip is in module storage at
                    <code>@ModuleZip.StoragePath(ModuleId.ToLowerInvariant(), VersionOrPlaceholder(_versionForm.Name))</code>;
                    its URL then follows the configured CDN. Set it only for a zip hosted elsewhere.
                </p>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="version-hash">SHA-256</BbLabel>
                <BbInput Id="version-hash" @bind-Value="_versionForm.Hash" Class="bb:font-mono"
                         Placeholder="64 hex characters"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="version-changelog">Changelog URL</BbLabel>
                <BbInput Id="version-changelog" @bind-Value="_versionForm.ChangelogUrl"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="version-release">Release URL</BbLabel>
                <BbInput Id="version-release" @bind-Value="_versionForm.ReleaseUrl"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _versionFormOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveVersionAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private ApiConfig ApiConfig { get; set; } = null!;

    /// <summary>The module's id, from the route. Ids are lowercased by the service.</summary>
    [Parameter, EditorRequired] public required string ModuleId { get; set; }

    private Module? _module;
    private SourceRepository[] _repositories = [];
    private VersionRow[] _versions = [];

    /// <summary>
    /// Which module the fields above hold. The router reuses this component when one module page
    /// links to another, and OnInitialized does not run a second time, so the read is keyed on this
    /// rather than on the component's lifetime.
    /// </summary>
    private string? _loaded;

    private bool _moduleFormOpen;
    private ModuleFormModel _moduleForm = new();

    private bool _uploadOpen;
    private bool _uploading;
    private UploadFormModel _upload = new();

    private bool _versionFormOpen;
    private bool _editingVersion;
    private VersionFormModel _versionForm = new();

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _loaded = ModuleId;
        _module = await scope.Get<ModuleAdminService>().FindAsync(ModuleId);
        _repositories = await scope.Get<PublisherAdminService>().ListAsync();

        _versions = _module is null
            ? []
            : ModuleVersions.NewestFirst(_module.Versions).Select(v => VersionRow.From(v, ApiConfig.Modules)).ToArray();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != ModuleId) await ReloadAsync();
    }

    private string? OwnerName(Guid? repositoryId)
    {
        if (repositoryId is not { } id) return null;
        var repository = _repositories.FirstOrDefault(r => r.Id == id);
        return repository is null ? null : $"{repository.Owner}/{repository.Repo}";
    }

    private static string VersionOrPlaceholder(string? version) =>
        string.IsNullOrWhiteSpace(version) ? "{version}" : version.Trim().ToLowerInvariant();

    /// <summary>The URL a version gets when its zip is in module storage.</summary>
    private string HostedUrl(string? version) =>
        $"{ApiConfig.Modules.CdnBaseUrl.TrimEnd('/')}/{ModuleZip.StoragePath(ModuleId.ToLowerInvariant(), VersionOrPlaceholder(version))}";

    /// <summary>Keeps a URL to one line in a cell; the full value stays in the title attribute.</summary>
    private static string Shorten(string url) => url.Length <= 56 ? url : $"{url[..53]}…";

    private void OpenEditModule()
    {
        if (_module is null) return;

        _moduleForm = ModuleFormModel.From(_module);
        _moduleFormOpen = true;
    }

    private async Task SaveModuleAsync()
    {
        if (!_moduleForm.TryGetValues(out var values, out var error))
        {
            ReportError(error);
            return;
        }

        _moduleFormOpen = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().UpsertAsync(
                values.Id, values.Name, values.Description, values.SourceUrl, values.IconUrl,
                values.RepositoryId);

            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}."),
                "Saved.");
        });
    }

    private async Task DeleteModuleAsync()
    {
        if (_module is null) return;

        var confirmed = await ConfirmAsync(
            "Delete module",
            $"Delete {_module.Id}? Its {_module.Versions.Count} published version(s) go with it.");

        if (!confirmed) return;

        var deleted = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().DeleteAsync(ModuleId);
            deleted = result.IsT0;

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That module no longer exists."),
                "Deleted.");
        });

        // This page is now about something that does not exist, so it cannot be what the admin is
        // left looking at.
        if (deleted) Navigation.NavigateTo("/admin/desktop/modules");
    }

    private void OpenUpload()
    {
        _upload = new UploadFormModel();
        _uploadOpen = true;
    }

    private void SelectZip(InputFileChangeEventArgs e) => _upload.File = e.File;

    private async Task UploadVersionAsync()
    {
        if (string.IsNullOrWhiteSpace(_upload.Name))
        {
            ReportError("A version is required.");
            return;
        }

        if (_upload.File is not { } file)
        {
            ReportError("Choose the module zip to upload.");
            return;
        }

        if (file.Size > ModulePublishService.MaxZipSize)
        {
            ReportError($"The zip is larger than {ModulePublishService.MaxZipSize / 1024 / 1024} MB.");
            return;
        }

        if (!FormValues.TryParseUri(_upload.ChangelogUrl, out var changelogUrl) ||
            !FormValues.TryParseUri(_upload.ReleaseUrl, out var releaseUrl))
        {
            ReportError("Changelog and release must be absolute URLs, or left empty.");
            return;
        }

        var name = _upload.Name.Trim();
        _uploading = true;

        try
        {
            await MutateAsync(async scope =>
            {
                await using var zip = file.OpenReadStream(ModulePublishService.MaxZipSize);
                var result = await scope.Get<ModulePublishService>().PublishAsync(
                    ModuleId, name, zip, changelogUrl, releaseUrl);

                Report(result.Match<string?>(_ => null, problem => problem.Title), $"Published {name}.");

                // Kept open on a refusal, so a wrong version or zip can be fixed without starting over.
                if (result.IsT0) _uploadOpen = false;
            });
        }
        finally
        {
            _uploading = false;
        }
    }

    private void OpenCreateVersion()
    {
        _editingVersion = false;
        _versionForm = new VersionFormModel();
        _versionFormOpen = true;
    }

    private void OpenEditVersion(VersionRow version)
    {
        _editingVersion = true;
        _versionForm = VersionFormModel.From(version);
        _versionFormOpen = true;
    }

    private async Task SaveVersionAsync()
    {
        if (!_versionForm.TryGetValues(out var values, out var error))
        {
            ReportError(error);
            return;
        }

        _versionFormOpen = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().UpsertVersionAsync(
                ModuleId, values.Name, values.ZipUrl, values.Hash, values.ChangelogUrl,
                values.ReleaseUrl);

            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}.",
                    invalid => $"{invalid.Version} is not a strict semantic version.",
                    _ => "The SHA-256 must be 64 hex characters."),
                $"Saved {values.Name}.");
        });
    }

    private async Task DeleteVersionAsync(VersionRow version)
    {
        var confirmed = await ConfirmAsync(
            "Withdraw version",
            $"Withdraw {ModuleId} {version.Name} from the index?",
            confirmText: "Withdraw");

        if (!confirmed) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().DeleteVersionAsync(ModuleId, version.Name);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That version no longer exists."),
                $"Withdrew {version.Name}.");
        });
    }

    /// <summary>
    /// One row of the versions grid. A projection rather than the entity: the grid and the form both
    /// want the digest as hex and the URLs as strings, and the entity's type name collides with
    /// <see cref="System.Version"/> in a Razor file. <c>ZipUrl</c> is what clients download from,
    /// built when the zip is in module storage; <c>StoredZipUrl</c> is what the row holds, null in
    /// that case.
    /// </summary>
    private sealed record VersionRow(
        string Name, string ZipUrl, string? StoredZipUrl, string Hash, string? ChangelogUrl,
        string? ReleaseUrl, bool Parseable, bool IsPrerelease)
    {
        public bool Hosted => StoredZipUrl is null;

        public static VersionRow From(RepoServerDb.Models.Version version, ModulesConfig config)
        {
            var parsed = ModuleVersions.Parse(version.VersionName);

            return new VersionRow(
                version.VersionName,
                ModuleZip.Url(config, version).ToString(),
                version.ZipUrl?.ToString(),
                FormValues.ToHex(version.HashSha256),
                version.ChangelogUrl?.ToString(),
                version.ReleaseUrl?.ToString(),
                parsed is not null,
                parsed?.IsPrerelease ?? false);
        }
    }

    /// <summary>What the upload dialog binds to.</summary>
    private sealed class UploadFormModel
    {
        public string Name { get; set; } = string.Empty;
        public IBrowserFile? File { get; set; }
        public string? ChangelogUrl { get; set; }
        public string? ReleaseUrl { get; set; }
    }

    private sealed record VersionFormValues(
        string Name, Uri? ZipUrl, byte[] Hash, Uri? ChangelogUrl, Uri? ReleaseUrl);

    /// <summary>What the version dialog binds to. Everything is text until it is saved.</summary>
    private sealed class VersionFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? ZipUrl { get; set; }
        public string? Hash { get; set; }
        public string? ChangelogUrl { get; set; }
        public string? ReleaseUrl { get; set; }

        public static VersionFormModel From(VersionRow row) => new()
        {
            Name = row.Name,
            // Only a URL actually stored on the row: a hosted version's URL is built, and saving it
            // back would freeze it against a later change of CDN.
            ZipUrl = row.StoredZipUrl,
            Hash = row.Hash,
            ChangelogUrl = row.ChangelogUrl,
            ReleaseUrl = row.ReleaseUrl
        };

        /// <summary>
        /// Parses the form. The semver check is the service's, because a row that does not parse is a
        /// data problem rather than a typing one; what is refused here is only what the service
        /// cannot be handed at all.
        /// </summary>
        public bool TryGetValues(
            [NotNullWhen(true)] out VersionFormValues? values, [NotNullWhen(false)] out string? error)
        {
            values = null;

            if (string.IsNullOrWhiteSpace(Name))
            {
                error = "A version is required.";
                return false;
            }

            if (!FormValues.TryParseUri(ZipUrl, out var zipUrl))
            {
                error = "The zip URL must be absolute, or left empty for module storage.";
                return false;
            }

            if (!FormValues.TryParseSha256(Hash, out var hash))
            {
                error = "The SHA-256 must be 64 hex characters.";
                return false;
            }

            if (!FormValues.TryParseUri(ChangelogUrl, out var changelogUrl) ||
                !FormValues.TryParseUri(ReleaseUrl, out var releaseUrl))
            {
                error = "Changelog and release must be absolute URLs, or left empty.";
                return false;
            }

            values = new VersionFormValues(Name.Trim(), zipUrl, hash, changelogUrl, releaseUrl);
            error = null;
            return true;
        }
    }
}
