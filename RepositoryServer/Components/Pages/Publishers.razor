@page "/admin/repositories"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@using BlazorBlueprint.Primitives
@inherits AdminDataPageBase

<PageHeader Title="Publishers">
    <Subtitle>Repositories allowed to publish through CI. Registration here is the authorization decision.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Register publisher</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="SourceRepository" TableContainerClass="@TableFrame.TableClass" Items="_repositories" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search publishers">
        <EmptyTemplate>
            <EmptyState Icon="IconName.KeyRound" Title="No publishers" Description="CI cannot publish anything until a repository is registered.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Register the first publisher</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="SourceRepository" TProp="string" Property="r => r.Owner" Title="Repository">
                <CellTemplate>
                    <code>@context.Owner/@context.Repo</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="SourceRepository" TProp="RepositoryProvider"
                                      Property="r => r.Provider" Title="Provider" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <CellTemplate>@AdminFormat.Label(context.Provider)</CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="SourceRepository" Title="Scopes" Sortable="false">
                @if (context.Scopes.Length == 0)
                {
                    <BbBadge Variant="BadgeVariant.SoftWarning">No scopes, cannot publish</BbBadge>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:gap-1">
                        @foreach (var scope in context.Scopes)
                        {
                            <BbBadge Variant="BadgeVariant.Outline">@scope.ToScopeClaim()</BbBadge>
                        }
                    </div>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="SourceRepository" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Revoke" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Register or update a publisher</BbDialogTitle>
            <BbDialogDescription>
                Owner and repo are matched case-insensitively, the same way the OIDC handler resolves
                them. Re-registering replaces the scopes, which is how a grant is widened or narrowed.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Provider</BbLabel>
                <BbSelect TValue="RepositoryProvider" @bind-Value="_provider">
                    <BbSelectTrigger TValue="RepositoryProvider">
                        <BbSelectValue Placeholder="provider"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="RepositoryProvider">
                        @foreach (var provider in Providers)
                        {
                            <BbSelectItem TValue="RepositoryProvider" Value="@provider"
                                          Text="@provider.ToString().ToLowerInvariant()"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
            <BbTabs @bind-Value="_entryMode">
                <BbTabsList Class="bb:w-full">
                    <BbTabsTrigger Value="@BrowseTab">Browse @(_provider.ToString().ToLowerInvariant())</BbTabsTrigger>
                    <BbTabsTrigger Value="@ManualTab">Enter manually</BbTabsTrigger>
                </BbTabsList>

                <BbTabsContent Value="@BrowseTab" Class="bb:flex bb:flex-col bb:gap-4 bb:pt-4">
                    <div class="bb:flex bb:flex-col bb:gap-2">
                        <BbLabel For="browse-owner">User or organization</BbLabel>
                        <div class="bb:flex bb:items-center bb:gap-2">
                            <BbInput Id="browse-owner" Class="bb:flex-1" Placeholder="OpenShock"
                                     @bind-Value="_owner" @bind-Value:after="LoadRepositoriesAsync"/>
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall"
                                      OnClick="LoadRepositoriesAsync" Disabled="_repositoriesLoading"
                                      AriaLabel="List repositories" title="List repositories">
                                @if (_repositoriesLoading)
                                {
                                    <BbSpinner Size="SpinnerSize.Small"/>
                                }
                                else
                                {
                                    <Glyph Name="IconName.Refresh"/>
                                }
                            </BbButton>
                        </div>
                    </div>
                    <div class="bb:flex bb:flex-col bb:gap-2">
                        <BbLabel>Repository</BbLabel>
                        <BbCombobox TValue="string" Options="RepositoryOptions" Value="@_repo"
                                    ValueChanged="SelectRepositoryAsync" MatchTriggerWidth="true"
                                    IsLoading="_repositoriesLoading"
                                    Placeholder="select a repository"
                                    SearchPlaceholder="filter repositories"
                                    EmptyMessage="@RepositoryEmptyMessage"/>
                        <p class="bb:text-muted-foreground bb:text-xs">
                            Public repositories only. GitHub is asked without a credential, so a private
                            repository never appears here and has to be entered by hand.
                        </p>
                    </div>
                </BbTabsContent>

                <BbTabsContent Value="@ManualTab" Class="bb:flex bb:flex-col bb:gap-4 bb:pt-4">
                    <div class="bb:flex bb:flex-col bb:gap-2">
                        <BbLabel For="owner">Owner</BbLabel>
                        <BbInput Id="owner" @bind-Value="_owner" Placeholder="OpenShock"/>
                    </div>
                    <div class="bb:flex bb:flex-col bb:gap-2">
                        <BbLabel For="repo">Repository</BbLabel>
                        <BbInput Id="repo" @bind-Value="_repo" Placeholder="firmware"/>
                    </div>
                </BbTabsContent>
            </BbTabs>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Scopes</BbLabel>
                @foreach (var scope in Scopes)
                {
                    var current = scope;
                    <div class="bb:flex bb:items-center bb:gap-2">
                        <BbCheckbox Id="@($"scope-{current}")" Checked="_scopes.Contains(current)"
                                    CheckedChanged="@(checkedNow => ToggleScope(current, checkedNow))"/>
                        <BbLabel For="@($"scope-{current}")">@current.ToScopeClaim()</BbLabel>
                    </div>
                }
                <p class="bb:text-muted-foreground bb:text-xs">A publisher with no scopes can publish nothing.</p>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly RepositoryProvider[] Providers = Enum.GetValues<RepositoryProvider>();
    private static readonly RepositoryScope[] Scopes = Enum.GetValues<RepositoryScope>();

    private SourceRepository[] _repositories = [];

    private const string BrowseTab = "browse";
    private const string ManualTab = "manual";

    private bool _formOpen;
    private RepositoryProvider _provider = RepositoryProvider.Github;
    private string _owner = string.Empty;
    private string _repo = string.Empty;
    private readonly HashSet<RepositoryScope> _scopes = [];

    private string _entryMode = ManualTab;
    private GitHubRepositoryRef[] _ownerRepositories = [];
    private bool _repositoriesLoading;
    private string? _listedOwner;

    [Inject] private GitHubPublicRepositoryService GitHub { get; set; } = null!;

    private IEnumerable<SelectOption<string>> RepositoryOptions =>
        _ownerRepositories.Select(r => new SelectOption<string>(r.Repo, r.Repo));

    private string RepositoryEmptyMessage =>
        _listedOwner is null
            ? "Enter a user or organization first."
            : $"No public repositories found for {_listedOwner}.";

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _repositories = await scope.Get<PublisherAdminService>().ListAsync();
    }

    private void ToggleScope(RepositoryScope scope, bool selected)
    {
        if (selected) _scopes.Add(scope);
        else _scopes.Remove(scope);
    }

    private async Task OpenCreate()
    {
        ResetForm();
        _formOpen = true;

        // Registering a repository of the organization admins log in through is the ordinary case,
        // so that listing is fetched up front and the dialog opens on a populated picker.
        _owner = GitHub.DefaultOwner ?? string.Empty;
        _entryMode = _owner.Length == 0 ? ManualTab : BrowseTab;

        if (_entryMode == BrowseTab) await LoadRepositoriesAsync();
    }

    private void OpenEdit(SourceRepository repository)
    {
        _formOpen = true;
        _provider = repository.Provider;
        _owner = repository.Owner;
        _repo = repository.Repo;
        _scopes.Clear();
        foreach (var scope in repository.Scopes) _scopes.Add(scope);

        // Editing an existing publisher is almost always a scope change, and the identity is
        // already correct. The manual tab shows it as stored rather than inviting a re-pick that
        // could silently retarget the grant.
        _entryMode = ManualTab;
        ClearRepositoryListing();
    }

    private void ResetForm()
    {
        _provider = RepositoryProvider.Github;
        _owner = string.Empty;
        _repo = string.Empty;
        _scopes.Clear();
        _entryMode = ManualTab;
        ClearRepositoryListing();
    }

    private void ClearRepositoryListing()
    {
        _ownerRepositories = [];
        _listedOwner = null;
    }

    /// <summary>
    /// Reads the current owner's public repositories. Repeats are cheap - the service caches per
    /// owner - so this can run on every edit of the owner field.
    /// </summary>
    private async Task LoadRepositoriesAsync()
    {
        var owner = _owner.Trim();
        if (owner.Length == 0)
        {
            ClearRepositoryListing();
            return;
        }

        _repositoriesLoading = true;
        try
        {
            _ownerRepositories = await GitHub.ListPublicRepositoriesAsync(owner);
            _listedOwner = owner;
        }
        finally
        {
            _repositoriesLoading = false;
        }

        // A repository picked from a previous owner is not in this listing and must not stay
        // selected, or Save would register a pair that was never on screen together.
        if (_repo.Length != 0 && !_ownerRepositories.Any(r => r.Repo == _repo))
        {
            _repo = string.Empty;
        }
    }

    private Task SelectRepositoryAsync(string? repo)
    {
        _repo = repo ?? string.Empty;

        // Take the owner from the listing rather than from what was typed: GitHub resolves owners
        // case-insensitively, and the row should read the way GitHub spells it.
        var selected = _ownerRepositories.FirstOrDefault(r => r.Repo == _repo);
        if (selected.Repo is not null) _owner = selected.Owner;

        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_owner) || string.IsNullOrWhiteSpace(_repo))
        {
            ReportError("Owner and repository are both required.");
            return;
        }

        // Read the form into locals before it is cleared: the change below runs after the dialog
        // has closed, and a field cleared underneath it would register an empty repository.
        var provider = _provider;
        var owner = _owner.Trim();
        var repo = _repo.Trim();
        RepositoryScope[] scopes = [.. _scopes];

        _formOpen = false;
        ResetForm();

        await MutateAsync(async scope =>
        {
            await scope.Get<PublisherAdminService>().UpsertAsync(provider, owner, repo, scopes);
            Report(null, $"Registered {owner}/{repo}.");
        });
    }

    private async Task DeleteAsync(SourceRepository repository)
    {
        var confirmed = await ConfirmAsync(
            "Revoke publisher",
            $"Revoke publishing for {repository.Owner}/{repository.Repo}?",
            confirmText: "Revoke");

        if (!confirmed) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<PublisherAdminService>().DeleteAsync(repository.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That publisher no longer exists.",
                    inUse => $"Cannot remove: {inUse.ReferencedBy} record it as their source. " +
                             "Clear its scopes instead, which revokes publishing without losing provenance."),
                "Revoked.");
        });
    }
}
