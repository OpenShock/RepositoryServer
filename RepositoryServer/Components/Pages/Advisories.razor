@page "/admin/firmware/advisories"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Advisories">
    <Subtitle>Warnings on the public manifest, shown by the flashtool and hubs.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add advisory</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="FirmwareAdvisory" TableContainerClass="@TableFrame.TableClass" Items="_advisories" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search advisories">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Shield" Title="No advisories"
                        Description="Nothing is being flagged to users about any firmware version.">
                <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCreate">Publish an advisory</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="FirmwareAdvisory" TProp="AdvisorySeverity"
                                      Property="a => a.Severity" Title="Severity">
                <CellTemplate>
                    <BbBadge Variant="@SeverityVariant(context.Severity)">@AdminFormat.Label(context.Severity)</BbBadge>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareAdvisory" TProp="string" Property="a => a.Title" Title="Title"/>
            <BbDataGridPropertyColumn TData="FirmwareAdvisory" TProp="string"
                                      Property="a => a.AffectedVersions" Title="Affects" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <CellTemplate>
                    <code>@context.AffectedVersions</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="FirmwareAdvisory" Title="Link" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                @if (context.Url is { } url)
                {
                    <a href="@url" target="_blank" rel="noreferrer" class="bb:inline-flex bb:items-center bb:gap-1 bb:text-sm bb:underline">
                        Open
                        <Glyph Name="IconName.ExternalLink" Class="size-3"/>
                    </a>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="FirmwareAdvisory" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingId is null ? "New advisory" : $"Edit {_title}")</BbDialogTitle>
            <BbDialogDescription>
                Served on the public firmware manifest. Affected versions is a semver range.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Severity</BbLabel>
                <BbSelect TValue="AdvisorySeverity" @bind-Value="_severity">
                    <BbSelectTrigger TValue="AdvisorySeverity">
                        <BbSelectValue Placeholder="severity"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="AdvisorySeverity">
                        @foreach (var severity in Severities)
                        {
                            <BbSelectItem TValue="AdvisorySeverity" Value="@severity"
                                          Text="@severity.ToString().ToLowerInvariant()"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="title">Title</BbLabel>
                <BbInput Id="title" @bind-Value="_title" Placeholder="OTA bricking bug"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="content">Content</BbLabel>
                <BbTextarea Id="content" @bind-Value="_content" Class="bb:min-h-24"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="affects">Affected versions</BbLabel>
                <BbInput Id="affects" @bind-Value="_affectedVersions" Placeholder="&lt;1.4.0"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="url">Link</BbLabel>
                <BbInput Id="url" @bind-Value="_url"
                         Placeholder="https://github.com/OpenShock/firmware/issues/123"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly AdvisorySeverity[] Severities = Enum.GetValues<AdvisorySeverity>();

    private FirmwareAdvisory[] _advisories = [];

    private bool _formOpen;
    private Guid? _editingId;
    private AdvisorySeverity _severity = AdvisorySeverity.Info;
    private string _title = string.Empty;
    private string _content = string.Empty;
    private string _affectedVersions = string.Empty;
    private string? _url;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _advisories = await scope.Get<AdvisoryAdminService>().ListAsync();
    }

    private static BadgeVariant SeverityVariant(AdvisorySeverity severity) => severity switch
    {
        AdvisorySeverity.Critical => BadgeVariant.SoftDestructive,
        AdvisorySeverity.Warning => BadgeVariant.SoftWarning,
        _ => BadgeVariant.SoftInfo
    };

    private void OpenCreate()
    {
        ResetForm();
        _formOpen = true;
    }

    private void OpenEdit(FirmwareAdvisory advisory)
    {
        _formOpen = true;
        _editingId = advisory.Id;
        _severity = advisory.Severity;
        _title = advisory.Title;
        _content = advisory.Content;
        _affectedVersions = advisory.AffectedVersions;
        _url = advisory.Url;
    }

    private void ResetForm()
    {
        _editingId = null;
        _severity = AdvisorySeverity.Info;
        _title = string.Empty;
        _content = string.Empty;
        _affectedVersions = string.Empty;
        _url = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) ||
            string.IsNullOrWhiteSpace(_content) ||
            string.IsNullOrWhiteSpace(_affectedVersions))
        {
            ReportError("Title, content and affected versions are all required.");
            return;
        }

        // Read the form into locals before it is cleared: the change below runs after the dialog
        // has closed, and a field cleared underneath it would submit an empty advisory.
        var url = string.IsNullOrWhiteSpace(_url) ? null : _url.Trim();
        var editingId = _editingId;
        var severity = _severity;
        var title = _title;
        var content = _content;
        var affectedVersions = _affectedVersions;

        _formOpen = false;
        ResetForm();

        await MutateAsync(async scope =>
        {
            var advisories = scope.Get<AdvisoryAdminService>();

            if (editingId is { } advisoryId)
            {
                var result = await advisories.UpdateAsync(
                    advisoryId, severity, title, content, affectedVersions, url);

                Report(
                    result.Match<string?>(
                        _ => null,
                        _ => "That advisory no longer exists."),
                    "Saved.");
            }
            else
            {
                await advisories.CreateAsync(severity, title, content, affectedVersions, url);
                Report(null, "Published to the manifest.");
            }
        });
    }

    private async Task DeleteAsync(FirmwareAdvisory advisory)
    {
        if (!await ConfirmAsync("Delete advisory", $"Delete \"{advisory.Title}\"?")) return;

        if (_editingId == advisory.Id) ResetForm();

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<AdvisoryAdminService>().DeleteAsync(advisory.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That advisory no longer exists."),
                "Deleted.");
        });
    }
}
