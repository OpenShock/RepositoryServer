@page "/admin/firmware/usb-serial-filters"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Serial filters">
    <Subtitle>Which devices the WebSerial port picker offers. An empty PID matches the whole vendor.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add filter</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="UsbSerialFilter" TableContainerClass="@TableFrame.TableClass" Items="_filters" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search filters">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Filter" Title="No filters"
                        Description="Without these the port picker has nothing to narrow its list by.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add the first filter</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="UsbSerialFilter" TProp="string" Property="f => f.Description"
                                      Title="Description"/>
            <BbDataGridPropertyColumn TData="UsbSerialFilter" TProp="int" Property="f => f.Vid" Title="VID">
                <CellTemplate>
                    <code>@UsbIdentifier.Format(context.Vid)</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="UsbSerialFilter" Title="PID">
                @if (context.Pid is { } pid)
                {
                    <code>@UsbIdentifier.Format(pid)</code>
                }
                else
                {
                    <span class="bb:text-muted-foreground">Any</span>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="UsbSerialFilter" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editing ? "Edit filter" : "Add a filter")</BbDialogTitle>
            <BbDialogDescription>
                Leaving the PID empty matches an entire vendor, and there can only be one vendor-wide
                row per VID.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="vid">VID</BbLabel>
                <BbInput Id="vid" @bind-Value="_vid" Placeholder="0x1A86"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="pid">PID</BbLabel>
                <BbInput Id="pid" @bind-Value="_pid" Placeholder="0x7522"/>
                <p class="bb:text-muted-foreground bb:text-xs">Empty matches the whole vendor.</p>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="description">Description</BbLabel>
                <BbInput Id="description" @bind-Value="_description" Placeholder="QinHeng CH340"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="UpsertAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private UsbSerialFilter[] _filters = [];

    private bool _formOpen;
    private bool _editing;
    private string _vid = string.Empty;
    private string? _pid;
    private string? _description;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _filters = await scope.Get<CatalogAdminService>().ListUsbSerialFiltersAsync();
    }

    private void OpenCreate()
    {
        _editing = false;
        ResetForm();
        _formOpen = true;
    }

    private void OpenEdit(UsbSerialFilter filter)
    {
        _editing = true;
        _formOpen = true;
        _vid = UsbIdentifier.Format(filter.Vid);
        _pid = filter.Pid is { } pid ? UsbIdentifier.Format(pid) : null;
        _description = filter.Description;
    }

    private void ResetForm()
    {
        _vid = string.Empty;
        _pid = null;
        _description = null;
    }

    private async Task UpsertAsync()
    {
        if (!UsbIdentifier.TryParse(_vid, out var vid))
        {
            ReportError("VID and PID must be numbers, in hex (0x1A86) or decimal.");
            return;
        }

        int? pid = null;
        if (!string.IsNullOrWhiteSpace(_pid))
        {
            if (!UsbIdentifier.TryParse(_pid, out var parsedPid))
            {
                ReportError("VID and PID must be numbers, in hex (0x1A86) or decimal.");
                return;
            }

            pid = parsedPid;
        }

        var description = string.IsNullOrWhiteSpace(_description) ? null : _description;

        _formOpen = false;
        ResetForm();

        await MutateAsync(async scope =>
        {
            await scope.Get<CatalogAdminService>().UpsertUsbSerialFilterAsync(vid, pid, description);
            Report(null, "Saved.");
        });
    }

    private async Task DeleteAsync(UsbSerialFilter filter)
    {
        var label = filter.Pid is { } pid ? $"{UsbIdentifier.Format(filter.Vid)}:{UsbIdentifier.Format(pid)}" : $"{UsbIdentifier.Format(filter.Vid)}:any";
        if (!await ConfirmAsync("Delete filter", $"Delete the filter for {label}?")) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<CatalogAdminService>().DeleteUsbSerialFilterAsync(filter.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That filter no longer exists."),
                "Deleted.");
        });
    }
}
