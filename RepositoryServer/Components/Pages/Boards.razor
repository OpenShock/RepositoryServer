@page "/admin/firmware/boards"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Boards">
    <Subtitle>Hardware that firmware is built for. Names must match the firmware repository exactly.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add board</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="FirmwareBoard" TableContainerClass="@TableFrame.TableClass" Items="_boards" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search boards">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Board" Title="No boards"
                        Description="Release init rejects a board it does not know, so CI cannot publish yet.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add the first board</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="FirmwareBoard" TProp="string" Property="b => b.Name"
                                      Id="board-name" Title="Name">
                <CellTemplate>
                    <code>@context.Name</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="FirmwareBoard" TProp="string"
                                      Property="b => b.ChipNavigation.Name" Id="chip-name" Title="Chip"/>
            <BbDataGridTemplateColumn TData="FirmwareBoard" Title="Required artifacts" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                @if (context.RequiredArtifactTypes.Length == 0)
                {
                    <span class="bb:text-muted-foreground">None</span>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:gap-1">
                        @foreach (var artifactType in context.RequiredArtifactTypes)
                        {
                            <BbBadge Variant="BadgeVariant.Outline">
                                @artifactType.ToString().ToLowerInvariant()
                            </BbBadge>
                        }
                    </div>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="FirmwareBoard" Title="USB devices" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <span class="bb:text-muted-foreground">@AttachedDeviceNames(context.Id)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridPropertyColumn TData="FirmwareBoard" TProp="bool" Property="b => b.Discontinued"
                                      Title="Status" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <CellTemplate>
                    <StatusDot Active="!context.Discontinued" Label="@(context.Discontinued ? "Discontinued" : "Active")"/>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="FirmwareBoard" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="USB devices" Icon="IconName.Usb" OnClick="() => OpenAttach(context)"/>
                    <RowAction Label="@(context.Discontinued ? "Reinstate" : "Discontinue")"
                               Icon="@(context.Discontinued ? IconName.Restore : IconName.Archive)"
                               OnClick="() => SetDiscontinuedAsync(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editingBoardId is null ? "Add a board" : $"Edit {_name}")</BbDialogTitle>
            <BbDialogDescription>
                The name must match the [env:...] name in the firmware repository exactly, and is also
                the board's segment in artifact URLs.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="board-name">Name</BbLabel>
                <BbInput Id="board-name" @bind-Value="_name" Placeholder="Wemos-D1-Mini-ESP32"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Chip</BbLabel>
                <BbSelect TValue="Guid?" @bind-Value="_chipId">
                    <BbSelectTrigger TValue="Guid?">
                        <BbSelectValue Placeholder="select a chip"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="Guid?">
                        @foreach (var chip in _chips)
                        {
                            <BbSelectItem TValue="Guid?" Value="@chip.Id" Text="@chip.Name"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Required artifacts</BbLabel>
                <p class="bb:text-muted-foreground bb:text-xs">
                    What an OTA update must supply. Publish refuses a board missing any of these.
                </p>
                @foreach (var artifactType in ArtifactTypes)
                {
                    var current = artifactType;
                    <div class="bb:flex bb:items-center bb:gap-2">
                        <BbCheckbox Id="@($"artifact-{current}")"
                                    Checked="_requiredArtifactTypes.Contains(current)"
                                    CheckedChanged="@(checkedNow => ToggleArtifactType(current, checkedNow))"/>
                        <BbLabel For="@($"artifact-{current}")">
                            @current.ToString().ToLowerInvariant()
                        </BbLabel>
                    </div>
                }
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="SaveAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_attachOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>USB devices for @_attachBoardName</BbDialogTitle>
            <BbDialogDescription>
                On-board USB-to-serial converters, used to recognise the board in the flashtool.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Currently attached</BbLabel>
                <p class="bb:text-muted-foreground bb:text-sm">
                    @(_attachBoardId is { } id ? AttachedDeviceNames(id) : "None")
                </p>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel>Device</BbLabel>
                <BbSelect TValue="Guid?" @bind-Value="_attachDeviceId">
                    <BbSelectTrigger TValue="Guid?">
                        <BbSelectValue Placeholder="select a device"/>
                    </BbSelectTrigger>
                    <BbSelectContent TValue="Guid?">
                        @foreach (var device in _usbDevices)
                        {
                            <BbSelectItem TValue="Guid?" Value="@device.Id"
                                          Text="@($"{device.Name} ({UsbIdentifier.Format(device.Vid)}:{UsbIdentifier.Format(device.Pid)})")"/>
                        }
                    </BbSelectContent>
                </BbSelect>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline"
                      OnClick="() => ApplyAttachmentAsync(detach: true)">Detach</BbButton>
            <BbButton OnClick="() => ApplyAttachmentAsync(detach: false)">Attach</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly FirmwareArtifactType[] ArtifactTypes = Enum.GetValues<FirmwareArtifactType>();

    private FirmwareBoard[] _boards = [];
    private FirmwareChip[] _chips = [];
    private UsbDevice[] _usbDevices = [];
    private FirmwareBoardUsbDevice[] _attachments = [];

    private bool _formOpen;
    private bool _attachOpen;
    private string _attachBoardName = string.Empty;
    private Guid? _editingBoardId;
    private string _name = string.Empty;
    private Guid? _chipId;
    private readonly HashSet<FirmwareArtifactType> _requiredArtifactTypes = [];

    private Guid? _attachBoardId;
    private Guid? _attachDeviceId;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        var catalog = scope.Get<CatalogAdminService>();

        _boards = await catalog.ListBoardsAsync();
        _chips = await catalog.ListChipsAsync();
        _usbDevices = await catalog.ListUsbDevicesAsync();
        _attachments = await catalog.ListBoardUsbDevicesAsync();
    }

    private string AttachedDeviceNames(Guid boardId)
    {
        var names = _attachments
            .Where(a => a.BoardId == boardId)
            .Select(a => _usbDevices.FirstOrDefault(d => d.Id == a.UsbDeviceId)?.Name)
            .Where(n => n is not null)
            .ToArray();

        return names.Length == 0 ? "None" : string.Join(", ", names);
    }

    private void ToggleArtifactType(FirmwareArtifactType artifactType, bool selected)
    {
        if (selected) _requiredArtifactTypes.Add(artifactType);
        else _requiredArtifactTypes.Remove(artifactType);
    }

    private void OpenCreate()
    {
        ResetForm();
        _formOpen = true;
    }

    private void OpenAttach(FirmwareBoard board)
    {
        _attachBoardId = board.Id;
        _attachBoardName = board.Name;
        _attachDeviceId = null;
        _attachOpen = true;
    }

    private void OpenEdit(FirmwareBoard board)
    {
        _formOpen = true;
        _editingBoardId = board.Id;
        _name = board.Name;
        _chipId = board.ChipId;
        _requiredArtifactTypes.Clear();
        foreach (var artifactType in board.RequiredArtifactTypes) _requiredArtifactTypes.Add(artifactType);
    }

    private void ResetForm()
    {
        _editingBoardId = null;
        _name = string.Empty;
        _chipId = null;
        _requiredArtifactTypes.Clear();
    }

    private async Task SaveAsync()
    {
        if (_chipId is not { } chipId)
        {
            ReportError("Pick a chip.");
            return;
        }

        FirmwareArtifactType[] required = [.. _requiredArtifactTypes];

        // Read the form into locals before it is cleared: the change below runs after the dialog
        // has closed, and a field cleared underneath it would submit an empty board name.
        var editingBoardId = _editingBoardId;
        var name = _name;

        _formOpen = false;
        ResetForm();

        await MutateAsync(async scope =>
        {
            var catalog = scope.Get<CatalogAdminService>();

            if (editingBoardId is { } boardId)
            {
                var updated = await catalog.UpdateBoardAsync(boardId, name, chipId, required);
                Report(
                    updated.Match<string?>(
                        _ => null,
                        _ => "That board no longer exists.",
                        missing => $"No such {missing.Reference}.",
                        conflict => $"A board named \"{conflict.Name}\" already exists.",
                        InvalidNameMessage),
                    "Saved.");
            }
            else
            {
                var created = await catalog.CreateBoardAsync(name, chipId, required);
                Report(
                    created.Match<string?>(
                        _ => null,
                        missing => $"No such {missing.Reference}.",
                        conflict => $"A board named \"{conflict.Name}\" already exists.",
                        InvalidNameMessage),
                    $"Created {name}.");
            }
        });
    }

    private static string InvalidNameMessage(InvalidName invalid) =>
        $"\"{invalid.Name}\" is not a usable board name. Use letters, digits, '.', '_' or '-', " +
        "starting with a letter or digit.";

    private async Task SetDiscontinuedAsync(FirmwareBoard board)
    {
        var discontinued = !board.Discontinued;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<CatalogAdminService>()
                .SetBoardDiscontinuedAsync(board.Id, discontinued);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That board no longer exists."),
                discontinued ? "Discontinued. Existing hubs keep updating." : "Reinstated.");
        });
    }

    private async Task DeleteAsync(FirmwareBoard board)
    {
        if (!await ConfirmAsync("Delete board", $"Delete {board.Name}?")) return;

        if (_editingBoardId == board.Id) ResetForm();

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<CatalogAdminService>().DeleteBoardAsync(board.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That board no longer exists.",
                    inUse => $"Cannot delete: still referenced by {inUse.ReferencedBy}."),
                "Deleted.");
        });
    }

    private async Task ApplyAttachmentAsync(bool detach)
    {
        if (_attachBoardId is not { } boardId || _attachDeviceId is not { } deviceId)
        {
            ReportError("Pick a device.");
            return;
        }

        _attachDeviceId = null;

        await MutateAsync(async scope =>
        {
            var catalog = scope.Get<CatalogAdminService>();

            if (detach)
            {
                await catalog.DetachUsbDeviceFromBoardAsync(boardId, deviceId);
                Report(null, "Detached.");
            }
            else
            {
                var result = await catalog.AttachUsbDeviceToBoardAsync(boardId, deviceId);
                Report(
                    result.Match<string?>(
                        _ => null,
                        missing => $"No such {missing.Reference}."),
                    "Attached.");
            }
        });
    }
}
