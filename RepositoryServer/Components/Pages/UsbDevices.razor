@page "/admin/firmware/usb-devices"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="USB devices">
    <Subtitle>VID and PID pairs the flashtool uses to recognise a chip's native USB or a board's serial converter.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add device</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="UsbDevice" TableContainerClass="@TableFrame.TableClass" Items="_devices" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search devices">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Usb" Title="No USB devices"
                        Description="Without these the flashtool cannot recognise a connected board.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add the first device</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="UsbDevice" TProp="string" Property="d => d.Name" Title="Name"/>
            <BbDataGridPropertyColumn TData="UsbDevice" TProp="int" Property="d => d.Vid" Title="VID">
                <CellTemplate>
                    <code>@UsbIdentifier.Format(context.Vid)</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridPropertyColumn TData="UsbDevice" TProp="int" Property="d => d.Pid" Title="PID">
                <CellTemplate>
                    <code>@UsbIdentifier.Format(context.Pid)</code>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="UsbDevice" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="bb:sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_editing ? $"Edit {_name}" : "Add a USB device")</BbDialogTitle>
            <BbDialogDescription>
                Saving a VID and PID pair that already exists renames it rather than adding a second row.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:flex bb:flex-col bb:gap-4 bb:py-2">
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="vid">VID</BbLabel>
                <BbInput Id="vid" @bind-Value="_vid" Placeholder="0x1A86"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="pid">PID</BbLabel>
                <BbInput Id="pid" @bind-Value="_pid" Placeholder="0x7522"/>
            </div>
            <div class="bb:flex bb:flex-col bb:gap-2">
                <BbLabel For="name">Name</BbLabel>
                <BbInput Id="name" @bind-Value="_name" Placeholder="CH9102"/>
            </div>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="() => _formOpen = false">Cancel</BbButton>
            <BbButton OnClick="UpsertAsync">Save</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private UsbDevice[] _devices = [];

    private bool _formOpen;
    private bool _editing;
    private string _vid = string.Empty;
    private string _pid = string.Empty;
    private string _name = string.Empty;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _devices = await scope.Get<CatalogAdminService>().ListUsbDevicesAsync();
    }

    private void OpenCreate()
    {
        _editing = false;
        _vid = _pid = _name = string.Empty;
        _formOpen = true;
    }

    private void OpenEdit(UsbDevice device)
    {
        _editing = true;
        _vid = UsbIdentifier.Format(device.Vid);
        _pid = UsbIdentifier.Format(device.Pid);
        _name = device.Name;
        _formOpen = true;
    }

    private async Task UpsertAsync()
    {
        if (!UsbIdentifier.TryParse(_vid, out var vid) || !UsbIdentifier.TryParse(_pid, out var pid))
        {
            ReportError("VID and PID must be numbers, in hex (0x1A86) or decimal.");
            return;
        }

        _formOpen = false;

        await MutateAsync(async scope =>
        {
            await scope.Get<CatalogAdminService>().UpsertUsbDeviceAsync(vid, pid, _name);
            Report(null, "Saved.");
        });
    }

    private async Task DeleteAsync(UsbDevice device)
    {
        if (!await ConfirmAsync("Delete USB device", $"Delete {device.Name}?")) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<CatalogAdminService>().DeleteUsbDeviceAsync(device.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That device no longer exists.",
                    inUse => $"Cannot delete: still linked to {inUse.ReferencedBy}."),
                "Deleted.");
        });
    }
}
