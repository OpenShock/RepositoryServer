@page "/admin/desktop/modules"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Modules">
    <Subtitle>Modules in the desktop repository index. Open one to manage its versions.</Subtitle>
    <Actions>
        <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add module</BbButton>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

<TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
    <BbDataGrid TData="Module" TableContainerClass="@TableFrame.TableClass" Items="_modules" IsLoading="Loading" StickyHeader="true"
                ShowSearch="true" SearchPlaceholder="Search modules">
        <EmptyTemplate>
            <EmptyState Icon="IconName.Puzzle" Title="No modules" Description="The desktop index is empty.">
                <BbButton OnClick="OpenCreate"><Glyph Name="IconName.Plus"/>Add the first module</BbButton>
            </EmptyState>
        </EmptyTemplate>
        <Columns>
            <BbDataGridPropertyColumn TData="Module" TProp="string" Property="m => m.Name" Title="Module">
                <CellTemplate>
                    @* The name is the link rather than a separate action: it is what identifies the row. *@
                    <a href="@ModuleHref(context)" class="bb:flex bb:min-w-0 bb:flex-col">
                        <span class="bb:truncate bb:font-medium bb:hover:underline">@context.Name</span>
                        <code class="bb:text-muted-foreground bb:truncate bb:text-xs">@context.Id</code>
                    </a>
                </CellTemplate>
            </BbDataGridPropertyColumn>
            <BbDataGridTemplateColumn TData="Module" Title="Owner" Sortable="false">
                @if (OwnerName(context.RepositoryId) is { } owner)
                {
                    <code class="bb:text-muted-foreground">@owner</code>
                }
                else
                {
                    @* Closed to every publisher rather than open to any, but nothing can publish here. *@
                    <BbBadge Variant="BadgeVariant.SoftWarning">No owner</BbBadge>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="Module" Title="Latest" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                @if (ModuleVersions.Latest(context.Versions) is { } latest)
                {
                    <code>@latest</code>
                }
                else
                {
                    <span class="bb:text-muted-foreground">None published</span>
                }
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="Module" Title="Versions" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                <span class="bb:text-muted-foreground bb:tabular-nums">@context.Versions.Count</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn TData="Module" Title="" Sortable="false" Width="0">
                <RowActions>
                    <RowAction Label="Versions" Icon="IconName.Package" OnClick="() => Navigation.NavigateTo(ModuleHref(context))"/>
                    <RowAction Label="Edit" Icon="IconName.Pencil" OnClick="() => OpenEdit(context)"/>
                    <RowAction Label="Delete" Icon="IconName.Trash" Destructive="true" OnClick="() => DeleteAsync(context)"/>
                </RowActions>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</TableFrame>

<ModuleFormDialog @bind-Open="_formOpen" Model="_form" Repositories="_repositories"
                  IdLocked="_editing" OnSave="SaveAsync"/>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private Module[] _modules = [];
    private SourceRepository[] _repositories = [];

    private bool _formOpen;
    private bool _editing;
    private ModuleFormModel _form = new();

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        _modules = await scope.Get<ModuleAdminService>().ListAsync();
        _repositories = await scope.Get<PublisherAdminService>().ListAsync();
    }

    private static string ModuleHref(Module module) =>
        $"/admin/desktop/modules/{Uri.EscapeDataString(module.Id)}";

    private string? OwnerName(Guid? repositoryId)
    {
        if (repositoryId is not { } id) return null;
        var repository = _repositories.FirstOrDefault(r => r.Id == id);
        return repository is null ? null : $"{repository.Owner}/{repository.Repo}";
    }

    private void OpenCreate()
    {
        _editing = false;
        _form = new ModuleFormModel();
        _formOpen = true;
    }

    private void OpenEdit(Module module)
    {
        _editing = true;
        _form = ModuleFormModel.From(module);
        _formOpen = true;
    }

    private async Task SaveAsync()
    {
        if (!_form.TryGetValues(out var values, out var error))
        {
            ReportError(error);
            return;
        }

        _formOpen = false;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().UpsertAsync(
                values.Id, values.Name, values.Description, values.SourceUrl, values.IconUrl,
                values.RepositoryId);

            Report(
                result.Match<string?>(
                    _ => null,
                    missing => $"No such {missing.Reference}."),
                "Saved.");
        });
    }

    private async Task DeleteAsync(Module module)
    {
        var confirmed = await ConfirmAsync(
            "Delete module",
            $"Delete {module.Id}? Its {module.Versions.Count} published version(s) go with it.");

        if (!confirmed) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ModuleAdminService>().DeleteAsync(module.Id);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That module no longer exists."),
                "Deleted.");
        });
    }
}
