@page "/admin/firmware/releases"
@attribute [Authorize(Policy = AuthSchemas.Policies.Admin)]
@using OpenShock.RepositoryServer.RepoServerDb.Models
@inherits AdminDataPageBase

<PageHeader Title="Releases">
    <Subtitle>What CI has created, and what is being served.</Subtitle>
    <Actions>
        <RefreshButton Busy="Loading" OnClick="ReloadAsync"/>
    </Actions>
</PageHeader>

@*
    In flight first: it is short, and it is the only part an admin may have to act on. It drives the
    Needs attention entry on the overview, so the two have to agree on what "blocked" means.
*@
<section class="bb:flex bb:w-full bb:flex-col bb:gap-3" aria-labelledby="in-flight-heading">
    <div>
        <h2 id="in-flight-heading" class="bb:text-lg bb:font-semibold">In flight</h2>
        <p class="bb:text-muted-foreground bb:text-sm">
            Not published yet. A release whose changelog failed to parse cannot publish until the notes are fixed here.
        </p>
    </div>

    <TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
        <BbDataGrid TData="FirmwareRelease" TableContainerClass="@TableFrame.TableClass" Items="_releases" IsLoading="Loading" StickyHeader="true">
            <EmptyTemplate>
                <EmptyState Compact="true" Icon="IconName.Inbox" Title="Nothing in flight"/>
            </EmptyTemplate>
            <Columns>
                <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="string" Property="r => r.Version" Title="Version">
                    <CellTemplate>
                        <code>@context.Version</code>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="ReleaseChannel" Property="r => r.Channel" Title="Channel">
                    <CellTemplate>@AdminFormat.Label(context.Channel)</CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="ReleaseStatus" Property="r => r.Status" Title="Status">
                    <CellTemplate>
                        @if (context.Status == ReleaseStatus.Editing)
                        {
                            <BbBadge Variant="BadgeVariant.SoftWarning">Changelog blocked</BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Secondary">@AdminFormat.Label(context.Status)</BbBadge>
                        }
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="FirmwareRelease" Title="Source" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                    <CommitLink Repository="context.RepositoryNavigation" Commit="@context.CommitHash"/>
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn TData="FirmwareRelease" TProp="DateTimeOffset" Property="r => r.CreatedAt" Title="Created" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                    <CellTemplate>
                        <Timestamp Value="context.CreatedAt"/>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="FirmwareRelease" Title="Notes" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                    <span class="bb:text-muted-foreground">@NoteCount(context.Id)</span>
                </BbDataGridTemplateColumn>
                <BbDataGridTemplateColumn TData="FirmwareRelease" Title="" Sortable="false" Width="0">
                    @* One action, so the action itself rather than a menu of one. *@
                    <div class="bb:flex bb:justify-end">
                        <BbButton Variant="@(context.Status == ReleaseStatus.Editing ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                                  Size="ButtonSize.Small" Class="bb:whitespace-nowrap" OnClick="() => OpenChangelog(context)">
                            <Glyph Name="IconName.FileText"/>
                            Fix changelog
                        </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>
        </BbDataGrid>
    </TableFrame>
</section>

<section class="bb:mt-2 bb:flex bb:w-full bb:flex-col bb:gap-3" aria-labelledby="published-heading">
    <div>
        <h2 id="published-heading" class="bb:text-lg bb:font-semibold">Published versions</h2>
        <p class="bb:text-muted-foreground bb:text-sm">
            Unpublishing stops a version being served. Its artifacts stay in storage, since they are immutable.
        </p>
    </div>

    <TableFrame Failed="LoadFailed" OnRetry="ReloadAsync">
        <BbDataGrid TData="FirmwareVersion" TableContainerClass="@TableFrame.TableClass" Items="_versions" IsLoading="Loading" StickyHeader="true"
                    ShowSearch="true" SearchPlaceholder="Search versions">
            <EmptyTemplate>
                <EmptyState Compact="true" Icon="IconName.Package" Title="Nothing published yet"/>
            </EmptyTemplate>
            <Columns>
                <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="string" Property="v => v.Version" Title="Version">
                    <CellTemplate>
                        <code>@context.Version</code>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="ReleaseChannel" Property="v => v.Channel" Title="Channel">
                    <CellTemplate>@AdminFormat.Label(context.Channel)</CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="FirmwareVersion" Title="Source" Sortable="false" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                    <CommitLink Repository="context.RepositoryNavigation" Commit="@context.CommitHash"/>
                </BbDataGridTemplateColumn>
                <BbDataGridPropertyColumn TData="FirmwareVersion" TProp="DateTimeOffset" Property="v => v.ReleaseDate" Title="Released" HeaderClass="bb:hidden md:table-cell" CellClass="bb:hidden md:table-cell">
                    <CellTemplate>
                        <Timestamp Value="context.ReleaseDate"/>
                    </CellTemplate>
                </BbDataGridPropertyColumn>
                <BbDataGridTemplateColumn TData="FirmwareVersion" Title="" Sortable="false" Width="0">
                    <div class="bb:flex bb:justify-end">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="bb:text-destructive bb:whitespace-nowrap"
                                  OnClick="() => DeleteVersionAsync(context.Version)">
                            <Glyph Name="IconName.Trash"/>
                            Unpublish
                        </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>
        </BbDataGrid>
    </TableFrame>
</section>

<BbDialog @bind-Open="_changelogOpen">
    <BbDialogContent Class="sm:max-w-2xl">
        <BbDialogHeader>
            <BbDialogTitle>Fix changelog for @_changelogVersion</BbDialogTitle>
            <BbDialogDescription>
                Markdown with ### Heading sections. Replaces the staged notes wholesale and puts the
                release back into staging.
            </BbDialogDescription>
        </BbDialogHeader>

        <div class="bb:py-2">
            <BbTextarea @bind-Value="_changelog" Class="min-h-64 bb:font-mono"
                        Placeholder="### Breaking&#10;**Config format** &#8212; Changed to TOML&#10;&#10;### Info&#10;- Fixed WiFi reconnection"/>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="CloseChangelog">Cancel</BbButton>
            <BbButton OnClick="FixChangelogAsync">Save and return to staging</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private FirmwareRelease[] _releases = [];
    private FirmwareVersion[] _versions = [];
    private Dictionary<Guid, int> _noteCounts = new();

    private bool _changelogOpen;
    private Guid? _changelogReleaseId;
    private string _changelogVersion = string.Empty;
    private string _changelog = string.Empty;

    protected override async Task LoadDataAsync(AsyncServiceScope scope)
    {
        var releases = scope.Get<ReleaseAdminService>();

        _releases = await releases.ListEditableAsync();
        _versions = await releases.ListVersionsAsync();

        // One grouped count rather than a ListStagedNotesAsync per release: the note bodies were
        // fetched only to be thrown away after reading .Length, once per row.
        var releaseIds = _releases.Select(r => r.Id).ToArray();
        _noteCounts = await scope.Get<RepoServerContext>().FirmwareStagedReleaseNotes
            .Where(n => releaseIds.Contains(n.ReleaseId))
            .GroupBy(n => n.ReleaseId)
            .Select(g => new { ReleaseId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.ReleaseId, x => x.Count);
    }

    /// <summary>
    /// A release with no staged notes has no rows to group, so it is absent from the dictionary
    /// rather than present with zero.
    /// </summary>
    private string NoteCount(Guid releaseId) =>
        _noteCounts.GetValueOrDefault(releaseId) is var count && count == 0
            ? "None"
            : AdminFormat.Count(count, "section");

    private void OpenChangelog(FirmwareRelease release)
    {
        _changelogReleaseId = release.Id;
        _changelogVersion = release.Version;
        _changelog = string.Empty;
        _changelogOpen = true;
    }

    private void CloseChangelog()
    {
        _changelogOpen = false;
        _changelogReleaseId = null;
        _changelog = string.Empty;
    }

    private async Task FixChangelogAsync()
    {
        if (_changelogReleaseId is not { } releaseId) return;

        var changelog = _changelog;

        CloseChangelog();

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ReleaseAdminService>().FixChangelogAsync(releaseId, changelog);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That release no longer exists.",
                    notEditable => $"Release is {notEditable.Status.ToString().ToLowerInvariant()}, " +
                                   "which cannot be edited.",
                    ChangelogMessage),
                "Saved. The release is back in staging and can be published.");
        });
    }

    private static string ChangelogMessage(InvalidChangelog invalid) => invalid.Error switch
    {
        ChangelogParseError.Empty => "Changelog is empty or whitespace-only.",
        ChangelogParseError.NoHeadings => "Changelog contains no '### Heading' sections.",
        ChangelogParseError.AllSectionsEmpty => "All changelog sections are empty.",
        _ => $"Changelog could not be parsed ({invalid.Error})."
    };

    private async Task DeleteVersionAsync(string version)
    {
        var confirmed = await ConfirmAsync(
            "Unpublish version",
            $"Stop serving {version}? Artifacts stay in storage.",
            confirmText: "Unpublish");

        if (!confirmed) return;

        await MutateAsync(async scope =>
        {
            var result = await scope.Get<ReleaseAdminService>().DeleteVersionAsync(version);

            Report(
                result.Match<string?>(
                    _ => null,
                    _ => "That version no longer exists."),
                $"Unpublished {version}.");
        });
    }
}
