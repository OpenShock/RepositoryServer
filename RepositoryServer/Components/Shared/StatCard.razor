@*
    One figure, style guide §3.1: title left, glyph right, number, qualifier. The whole card is the
    link to the page that manages it, rather than a small "Manage" link inside it.
*@
<a href="@Href" class="bb:bg-card bb:hover:bg-accent bb:flex bb:min-w-0 bb:flex-col bb:gap-1 bb:rounded-lg bb:border bb:p-4 bb:transition-colors">
    <span class="bb:flex bb:items-center bb:justify-between bb:gap-2">
        <span class="bb:truncate bb:text-sm bb:font-medium">@Title</span>
        <Glyph Name="Icon" Class="bb:text-muted-foreground bb:size-4 bb:shrink-0"/>
    </span>
    <span class="bb:text-2xl font-bold bb:tabular-nums">@Value</span>
    <span class="bb:text-muted-foreground bb:min-h-4 bb:truncate bb:text-xs" title="@Note">@Note</span>
</a>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required int Value { get; set; }
    [Parameter, EditorRequired] public required IconName Icon { get; set; }
    [Parameter, EditorRequired] public required string Href { get; set; }

    /// <summary>Qualifier under the figure. The slot is kept when empty so a row of cards lines up.</summary>
    [Parameter] public string? Note { get; set; }
}
